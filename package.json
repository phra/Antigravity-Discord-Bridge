{
    "name": "antigravity-discord",
    "displayName": "Antigravity Discord Bridge",
    "description": "Bridge your VS Code AI chat with a Discord channel — messages are processed by the Language Model in your IDE and responses posted back in real-time",
    "version": "0.1.0",
    "publisher": "phra",
    "icon": "media/icon.png",
    "license": "MIT",
    "preview": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/phra/Antigravity-Discord-Bridge.git"
    },
    "homepage": "https://github.com/phra/Antigravity-Discord-Bridge#readme",
    "bugs": {
        "url": "https://github.com/phra/Antigravity-Discord-Bridge/issues"
    },
    "keywords": [
        "discord",
        "chat",
        "bridge",
        "ai",
        "language-model",
        "copilot",
        "gemini"
    ],
    "galleryBanner": {
        "color": "#5865F2",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.93.0"
    },
    "categories": [
        "Chat",
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "antigravity-discord",
                    "title": "Discord",
                    "icon": "media/discord.svg"
                }
            ]
        },
        "views": {
            "antigravity-discord": [
                {
                    "type": "webview",
                    "id": "antigravity-discord.chatView",
                    "name": "Discord Chat"
                }
            ]
        },
        "commands": [
            {
                "command": "antigravity-discord.reconnect",
                "title": "Antigravity Discord: Reconnect"
            }
        ],
        "configuration": {
            "title": "Antigravity Discord Bridge",
            "properties": {
                "antigravity-discord.botToken": {
                    "type": "string",
                    "default": "",
                    "description": "Discord Bot Token"
                },
                "antigravity-discord.channelId": {
                    "type": "string",
                    "default": "",
                    "description": "Discord Channel ID to bridge"
                },
                "antigravity-discord.debugPort": {
                    "type": "number",
                    "default": 9000,
                    "description": "Antigravity remote debugging port (--remote-debugging-port)"
                },
                "antigravity-discord.autoAccept": {
                    "type": "boolean",
                    "default": true,
                    "description": "Auto-click Accept/Run/Always Allow buttons during Discord message processing"
                }
            }
        }
    },
    "scripts": {
        "compile": "node esbuild.js",
        "compile:production": "node esbuild.js --production",
        "watch": "node esbuild.js --watch",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepackage": "npm run compile:production",
        "package": "vsce package"
    },
    "dependencies": {
        "discord.js": "^14.16.0",
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "@types/vscode": "^1.93.0",
        "@types/ws": "^8.18.1",
        "@vscode/vsce": "^3.7.1",
        "esbuild": "^0.25.1",
        "typescript": "^5.5.0",
        "vitest": "^4.0.18"
    }
}